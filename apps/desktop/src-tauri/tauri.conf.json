{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DeepSeek Harness Desktop",
  "version": "0.1.0",
  "identifier": "io.github.pan52.deepseek-harness-desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; script-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "Community macOS distribution of DeepSeek Harness",
    "copyright": "Copyright © 2026 DeepSeek Harness contributors",
    "macOS": {
      "bundleVersion": "0.1.705",
      "minimumSystemVersion": "13.5"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
